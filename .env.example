# Frontend (Next.js) — copy to .env.local for development, or set these in your
# deployment platform. Only NEXT_PUBLIC_* values reach the browser, and those are
# inlined at BUILD time, which is why the API base is deliberately not one of them.

# Where the Next.js server proxies /backend-api/* to. Read at request time, so
# changing it needs a restart, not a rebuild.
#   local development : http://localhost:8000
#   Coolify/Docker    : the backend service on the shared network, e.g.
#                       http://inspectra-backend:8000
BACKEND_ORIGIN=http://localhost:8000

# Optional. Set ONLY to make the browser call an absolute API origin directly,
# bypassing the proxy. That reintroduces a cross-origin request, so the exact
# origin must also be listed in the backend's CORS_ORIGINS.
# NEXT_PUBLIC_API_URL=

# ---------------------------------------------------------------------------
# BHASHINI machine translation (UI language switcher)
# ---------------------------------------------------------------------------
# These belong on the BACKEND service only. Never prefix them with NEXT_PUBLIC_:
# Next.js inlines those into the browser bundle at build time, which publishes
# the key to every visitor and lets them spend your quota.
#
# Set all of these on the inspectra-api resource in Coolify (or backend/.env
# locally). With no key set the app still runs; the language switcher hides
# itself and /api/translate answers 503 saying which variable is missing.
#
#   BHASHINI_INFERENCE_API_KEY     required. Sent as the Authorization header.
#   BHASHINI_UDYAT_KEY             optional. The inference endpoint authenticates
#                                  without it (verified by calling it with only
#                                  the inference key), so it is sent when present
#                                  and never required.
#   BHASHINI_TRANSLATION_SERVICE_ID  defaults to bhashini/iiith/nmt-all
#   BHASHINI_INFERENCE_URL         defaults to the dhruva pipeline endpoint

# BHASHINI_INFERENCE_API_KEY=
# BHASHINI_UDYAT_KEY=
# BHASHINI_TRANSLATION_SERVICE_ID=bhashini/iiith/nmt-all
# BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
