# Inspectra AI Backend Environment Configuration
# Copy this file to .env and fill in your values

# Application
DEBUG=true
APP_NAME=Inspectra AI

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://inspectra:inspectra@db:5432/inspectra

# Redis (optional, for caching and task queue)
# REDIS_URL=redis://redis:6379/0

# Security — CHANGE THIS IN PRODUCTION
SECRET_KEY=your-super-secret-key-change-me

# AWS (for S3 storage and optional deployment)
AWS_REGION=us-east-1
S3_BUCKET=inspectra-ai-storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Upload limits
MAX_UPLOAD_MB=100
